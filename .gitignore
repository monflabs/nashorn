*.iws
out/

# Visual Studio Code
.vscode/
*.code-workspace
.history/


# External benchmark and conformance suites, fetched with -Pfetch-externals
/core/src/test/scripts/external/

# Dropped by a Nashorn run when -Dnashorn.profilefile is in play
NashornProfile.txt

# heap dumps from -XX:+HeapDumpOnOutOfMemoryError in the test JVMs
*.hprof

# Javadoc copied into the docsify site by buildtools/build-javadoc.sh; generated
# at publish time, never checked in
/doc/nashorn/api/

# The browser (CheerpJ) playground, copied into the docsify site by
# buildtools/build-playground-site.sh; built at publish time, never checked in
/doc/nashorn/playground/*.jar
