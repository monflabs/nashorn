<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.monflabs.nashorn</groupId>
    <artifactId>nashorn-parent</artifactId>
    <version>2026.0.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>nashorn-core</artifactId>
  <packaging>jar</packaging>

  <name>OpenJDK-Monflabs core</name>
  <description>Nashorn is an Open Source JavaScript (ECMAScript 5.1 and some 6 features) engine for the JVM.</description>

  <properties>
    <!--
      javac writes here; nasgen reads from here and writes the instrumented
      classes into ${project.build.outputDirectory}. Keeping input and output
      apart means nasgen never sees its own output, so repeated incremental
      builds stay correct. The in-JDK build had the same hazard and guarded it
      with a marker file (_the.nasgen.run in CompileJavaModulesNashorn.gmk).
    -->
    <nashorn.raw.classes>${project.build.directory}/classes-raw</nashorn.raw.classes>
    <!-- Staging dirs, so every path below is static - no late-resolved properties. -->
    <nashorn.modules.dir>${project.build.directory}/modules</nashorn.modules.dir>
    <!--
      nasgen is used straight from its output directory rather than as a
      resolved artifact: dependency:copy cannot pull a reactor artifact that
      has not been packaged yet (MDEP-187), which would break "mvn test".
      nasgen builds before this module, being earlier in the reactor.
    -->
    <nashorn.nasgen.classes>${project.basedir}/../buildtools/nasgen/target/classes</nashorn.nasgen.classes>
    <nashorn.test.libs>${project.build.directory}/test-libs</nashorn.test.libs>

    <!-- Where the .js suite lives, relative to this module's basedir (which is
         surefire's working directory). Stack traces in the *.js.EXPECTED files
         embed this prefix, so it has to stay relative. -->
    <nashorn.test.scripts>src/test/scripts</nashorn.test.scripts>
    <!--
      test262 has no ES2015 branch or tag: only the frozen es5-tests branch and
      main, which tracks the current draft spec. So the suite is pinned to one
      commit of main and the ES2015 slice is selected out of it by frontmatter -
      see Test262Selector. Bumping the suite is a one-line change here.
    -->
    <nashorn.test262.commit>3655e7464de3d52643ecddd4b5f9f4f3e7f62398</nashorn.test262.commit>
    <nashorn.test262.suite>${nashorn.test.scripts}/external/test262-main</nashorn.test262.suite>
    <nashorn.test262.expectations>src/test/resources/test262-expectations.txt</nashorn.test262.expectations>
    <!-- the pessimistic run (-Dnashorn.test262.optimistic=false) is compared against its own file -->
    <nashorn.test262.expectations.pessimistic>src/test/resources/test262-expectations-pessimistic.txt</nashorn.test262.expectations.pessimistic>
    <nashorn.test262.threads>${nashorn.test262.default.threads}</nashorn.test262.threads>
    <!--
      Four, not eight. The count was chosen when generators and promises did not
      run: a generator now parks a virtual thread per live instance and a test can
      allocate a great deal more, and at eight the workers starve each other into
      timeouts and heap exhaustion. That is not a slow failure but a wrong one -
      at eight, between 1600 and 2400 tests failed spuriously and the set moved
      from run to run, which a ratchet cannot work with.
    -->
    <nashorn.test262.default.threads>4</nashorn.test262.default.threads>

    <!--
      How many processes the run is split across. A suspended generator's body
      holds its function and through it the whole realm it came from, so a long
      run accumulates realms until a worker dies of it - which used to surface
      only as a conformance number that moved by thousands between runs. Twelve
      keeps each process to a few thousand executions, which it can see through.
    -->
    <nashorn.test262.shards>12</nashorn.test262.shards>
    <!--
      Per-execution timeout, in seconds. The default is generous on purpose: a
      handful of tests exercise the whole BMP one code point at a time (the
      S7.4/S7.8.5 comment and regexp-literal torture tests, RegExp-leading-escape-BMP)
      and take tens of seconds even when they pass. On a slower or contended CI
      runner they would blow a tight budget, and a per-execution timeout that
      trips mid-run is not just its own failure - interrupting the worker thread
      can leave a shared structure inconsistent and take a concurrent, innocent
      execution down with it. 120s clears the heavy-but-terminating tests with
      room to spare while still catching a genuinely wedged adversarial iterator,
      which never terminates at any budget. Override with -Dnashorn.test262.timeout=.
    -->
    <nashorn.test262.timeout>120</nashorn.test262.timeout>
    <!-- narrow the run while developing, e.g. -Dnashorn.test262.include=/built-ins/Math/ -->
    <nashorn.test262.include/>
    <!--
      Rewrite the expectations file from this run instead of comparing against it.
      Declared as a property because the exec below forwards only what it names;
      a bare -Dtest262.write.expectations never reached the forked JVM.
    -->
    <nashorn.test262.write.expectations>false</nashorn.test262.write.expectations>
    <!--
      Optimistic types are the engine's default and the mode the default run
      uses; -Dnashorn.test262.optimistic=false runs the slice without them,
      against test262-expectations-pessimistic.txt.
    -->
    <nashorn.test262.optimistic>true</nashorn.test262.optimistic>
    <!--
      The suite runs several workers in one JVM, and since generators and promises
      landed it executes far more code than it used to; 2G, which the rest of the
      test JVM args ask for, is no longer enough and shows up as sporadic
      "Java heap space" failures that move from run to run.
    -->

    <nashorn.test.modulepath>${project.build.outputDirectory}${path.separator}${nashorn.modules.dir}</nashorn.test.modulepath>

    <!-- Set by the coverage profile; empty otherwise. -->
    <nashorn.coverage.argLine/>

    <!--
      Was run.test.jvmargs.common + test.module.imports.runtime. The tests are
      unnamed-module code that reaches into Nashorn internals. The Turkish
      locale is deliberate - it catches locale-sensitive case-conversion bugs.
    -->
    <nashorn.test.jvmargs>--module-path=${nashorn.test.modulepath} --add-modules=org.monflabs.nashorn --add-exports=org.monflabs.nashorn/org.monflabs.nashorn.internal.ir=ALL-UNNAMED --add-exports=org.monflabs.nashorn/org.monflabs.nashorn.internal.codegen=ALL-UNNAMED --add-exports=org.monflabs.nashorn/org.monflabs.nashorn.internal.parser=ALL-UNNAMED --add-exports=org.monflabs.nashorn/org.monflabs.nashorn.internal.objects=ALL-UNNAMED --add-exports=org.monflabs.nashorn/org.monflabs.nashorn.internal.runtime=ALL-UNNAMED --add-exports=org.monflabs.nashorn/org.monflabs.nashorn.internal.runtime.doubleconv=ALL-UNNAMED --add-exports=org.monflabs.nashorn/org.monflabs.nashorn.internal.runtime.linker=ALL-UNNAMED --add-exports=org.monflabs.nashorn/org.monflabs.nashorn.internal.runtime.events=ALL-UNNAMED --add-exports=org.monflabs.nashorn/org.monflabs.nashorn.internal.runtime.options=ALL-UNNAMED --add-exports=org.monflabs.nashorn/org.monflabs.nashorn.internal.runtime.regexp=ALL-UNNAMED --add-exports=org.monflabs.nashorn/org.monflabs.nashorn.internal.runtime.regexp.joni=ALL-UNNAMED --add-exports=org.monflabs.nashorn/org.monflabs.nashorn.tools=ALL-UNNAMED --add-opens=org.monflabs.nashorn/org.monflabs.nashorn.internal.runtime=ALL-UNNAMED --add-opens=org.monflabs.nashorn/org.monflabs.nashorn.internal.runtime.doubleconv=ALL-UNNAMED -Xmx2G -esa -ea -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=${project.build.directory} -Dfile.encoding=UTF-8 -Duser.language=tr -Duser.country=TR -Dnashorn.typeInfo.cacheDir=${project.build.directory}/test/type_info_cache -Dbuild.dir=target</nashorn.test.jvmargs>
  </properties>

  <!-- No compile dependencies: the bytecode work is done with java.lang.classfile. -->
  <dependencies>
    <dependency>
      <groupId>org.testng</groupId>
      <artifactId>testng</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.beust</groupId>
      <artifactId>jcommander</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.beanshell</groupId>
      <artifactId>bsh</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!--
      Mirrors the Ant layout (build/nashorn/test/classes), which SourceTest
      relies on: it locates its load_test.js resource as
      ${build.dir}/test/classes/... Keeping this under ${build.dir}/test also
      puts the per-script test output that TestHelper creates alongside it.
    -->
    <testOutputDirectory>${project.build.directory}/test/classes</testOutputDirectory>

    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <excludes>
          <exclude>**/version.properties</exclude>
        </excludes>
      </resource>
      <resource>
        <!-- version_short / version_string substituted from the POM version -->
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>**/version.properties</include>
        </includes>
      </resource>
    </resources>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>${nashorn.target.java.version}</release>
          <compilerArgs>
            <arg>-Xlint:all</arg>
            <arg>-XDignore.symbol.file</arg>
            <arg>-Xdiags:verbose</arg>
            <arg>-parameters</arg>
          </compilerArgs>
        </configuration>
        <executions>
          <execution>
            <id>default-compile</id>
            <configuration>
              <!-- pre-nasgen output; see nashorn.raw.classes above -->
              <outputDirectory>${nashorn.raw.classes}</outputDirectory>
            </configuration>
          </execution>
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <!--
                Compile the tests as ordinary classpath code. Without this,
                maven-compiler-plugin patches them into module
                org.monflabs.nashorn, which then cannot read java.xml or
                java.sql (module-info does not require them) and the test
                framework fails to compile. The Ant build likewise kept the
                tests in the unnamed module. Accessibility to Nashorn
                internals is granted at runtime instead, by the add-exports
                and add-opens flags in nashorn.test.jvmargs.
              -->
              <useModulePath>false</useModulePath>
              <compilerArgs>
                <arg>-Xlint:unchecked</arg>
                <arg>-Xlint:deprecation</arg>
                <arg>-Xdiags:verbose</arg>
              </compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <!--
              Everything javac produced, verbatim. nasgen then overwrites the
              @ScriptClass files and adds the generated $Constructor/$Prototype
              classes. Must run before the nasgen execution below - execution
              order within a phase follows plugin declaration order.
            -->
            <id>copy-compiled-classes</id>
            <phase>process-classes</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}</outputDirectory>
              <resources>
                <resource>
                  <directory>${nashorn.raw.classes}</directory>
                  <filtering>false</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <!-- ASM as a directory, used both as nasgen's classpath and as the
                 module path for the test compile and test run -->
            <id>stage-modules</id>
            <phase>process-classes</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <outputDirectory>${nashorn.modules.dir}</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
          <execution>
            <!--
              Test-only jars, staged as a directory so the JVMs that @fork
              script tests spawn can use a wildcard classpath.
            -->
            <id>stage-test-libs</id>
            <phase>process-classes</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <outputDirectory>${nashorn.test.libs}</outputDirectory>
              <includeScope>test</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <!--
              THE critical build step. Without it the @ScriptClass classes in
              org.monflabs.nashorn.internal.objects get no $Constructor or
              $Prototype, and every JavaScript built-in is missing at runtime -
              while the build still succeeds. See CLAUDE.md.
            -->
            <id>run-nasgen</id>
            <phase>process-classes</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>${java.home}/bin/java</executable>
              <arguments>
                <argument>-cp</argument>
                <argument>${nashorn.nasgen.classes}${path.separator}${nashorn.modules.dir}/*</argument>
                <argument>org.monflabs.nashorn.internal.tools.nasgen.Main</argument>
                <argument>${nashorn.raw.classes}</argument>
                <argument>org.monflabs.nashorn.internal.objects</argument>
                <argument>${project.build.outputDirectory}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- tests are unnamed-module code; Nashorn goes on the module path
               through argLine instead of surefire's own module handling -->
          <useModulePath>false</useModulePath>
          <!--
            @{} is surefire's late evaluation: jacoco:prepare-agent sets
            nashorn.coverage.argLine at initialize time, after ${} in plugin
            configuration has already been interpolated. With ${} here the
            agent is silently dropped and coverage comes out empty.
          -->
          <argLine>@{nashorn.coverage.argLine} ${nashorn.test.jvmargs}</argLine>
          <systemPropertyVariables>
            <!-- script-test discovery; was the test-sys-prop.* block -->
            <test.js.roots>${nashorn.test.scripts}/basic ${nashorn.test.scripts}/maptests ${nashorn.test.scripts}/error ${nashorn.test.scripts}/sandbox ${nashorn.test.scripts}/trusted ${nashorn.test.scripts}/nosecurity</test.js.roots>
            <test.js.framework>${nashorn.test.scripts}/assert.js</test.js.framework>
            <test.js.exclude.dir>${nashorn.test.scripts}/currently-failing ${nashorn.test.scripts}/external</test.js.exclude.dir>
            <test.js.unchecked.dir>${nashorn.test262.suite}</test.js.unchecked.dir>
            <test.js.shared.context>false</test.js.shared.context>
            <!-- stripped from each test's path to mirror its output under target/test -->
            <test.root.dir>src/test</test.root.dir>

            <test.basic.dir>${nashorn.test.scripts}/basic</test.basic.dir>
            <test.maptests.dir>${nashorn.test.scripts}/maptests</test.maptests.dir>
            <test.sandbox.dir>${nashorn.test.scripts}/sandbox</test.sandbox.dir>
            <test.trusted.dir>${nashorn.test.scripts}/trusted</test.trusted.dir>
            <test262.suite.dir>${nashorn.test262.suite}</test262.suite.dir>

            <parsertest.verbose>false</parsertest.verbose>
            <parsertest.scripting>true</parsertest.scripting>
            <parsertest.test262>false</parsertest.test262>
            <parserapitest.verbose>false</parserapitest.verbose>
            <parserapitest.test262>false</parserapitest.test262>
            <compilertest.verbose>false</compilertest.verbose>
            <compilertest.scripting>true</compilertest.scripting>
            <compilertest.test262>false</compilertest.test262>

            <!-- script tests carrying @fork spawn their own JVM with these -->
            <test.fork.jvm.options>${nashorn.test.jvmargs} -cp ${project.build.outputDirectory}${path.separator}${project.build.testOutputDirectory}${path.separator}${nashorn.test.libs}/*</test.fork.jvm.options>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <!-- was the "test-pessimistic" Ant target -->
            <id>test-pessimistic</id>
            <phase>test</phase>
            <goals><goal>test</goal></goals>
            <configuration>
              <reportsDirectory>${project.build.directory}/surefire-reports/pessimistic</reportsDirectory>
              <systemPropertyVariables>
                <optimistic.override>false</optimistic.override>
              </systemPropertyVariables>
            </configuration>
          </execution>
          <execution>
            <!--
              Was "test-optimistic". Both modes must keep running: optimistic
              typing takes a different path through the compiler, and a change
              can pass one mode while failing the other.
            -->
            <id>test-optimistic</id>
            <phase>test</phase>
            <goals><goal>test</goal></goals>
            <configuration>
              <reportsDirectory>${project.build.directory}/surefire-reports/optimistic</reportsDirectory>
              <systemPropertyVariables>
                <optimistic.override>true</optimistic.override>
              </systemPropertyVariables>
            </configuration>
          </execution>
          <execution>
            <!-- the implicit default execution would be a third, redundant run -->
            <id>default-test</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestSections>
              <manifestSection>
                <name>org/monflabs/nashorn/</name>
                <manifestEntries>
                  <Implementation-Title>${nashorn.product.name}</Implementation-Title>
                  <Implementation-Version>${project.version}</Implementation-Version>
                </manifestEntries>
              </manifestSection>
            </manifestSections>
          </archive>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <configuration>
          <!-- only the public API packages are documented: api.scripting, api.tree and api.debugger -->
          <excludePackageNames>org.monflabs.nashorn.internal:org.monflabs.nashorn.internal.*:org.monflabs.nashorn.tools:org.monflabs.nashorn.tools.*:org.monflabs.nashorn.api.linker</excludePackageNames>
          <tags>
            <tag><name>implSpec</name><placement>a</placement><head>Implementation Requirements:</head></tag>
            <tag><name>implNote</name><placement>a</placement><head>Implementation Note:</head></tag>
            <tag><name>moduleGraph</name><placement>a</placement><head>Module Graph</head></tag>
          </tags>
          <links>
            <link>https://docs.oracle.com/en/java/javase/${nashorn.target.java.version}/docs/api/</link>
          </links>
          <quiet>true</quiet>
        </configuration>
      </plugin>
      <plugin>
        <!-- a published artifact: opt in to the Central Portal publisher declared in the parent -->
        <groupId>org.sonatype.central</groupId>
        <artifactId>central-publishing-maven-plugin</artifactId>
        <configuration>
          <skipPublishing>false</skipPublishing>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!--
        Defines the os.not.windows system property that @runif os.not.windows
        script tests (e.g. exec.js, which spawns a process) gate on. Activated
        by OS family negation, so the property is simply absent on Windows and
        those tests skip there.
      -->
      <id>os-not-windows</id>
      <activation>
        <os>
          <family>!windows</family>
        </os>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <systemPropertyVariables>
                <os.not.windows>true</os.not.windows>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <!--
        Clones the external suites the benchmark and test262 profiles need.
        Was the get-test262 / get-octane / get-sunspider Ant targets. Run once:
          mvn -Pfetch-externals generate-test-resources
      -->
      <id>fetch-externals</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <!--
                git exits 128 when the destination already exists, which is
                treated as success so the profile is re-runnable.

                SunSpider is not fetched: the Ant build checked it out of
                http://svn.webkit.org/repository/webkit/trunk/PerformanceTests/SunSpider,
                and that SVN server no longer exists. Place a copy at
                src/test/scripts/external/sunspider by hand to use -Psunspider.
              -->
              <!--
                Pinned by commit rather than cloned by branch: the ES2015 slice
                has to be reproducible, and main moves daily. init + fetch of a
                single commit keeps the download to one revision.
              -->
              <execution>
                <id>init-test262</id>
                <phase>generate-test-resources</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>git</executable>
                  <successCodes><successCode>0</successCode><successCode>128</successCode></successCodes>
                  <commandlineArgs>init -q ${nashorn.test262.suite}</commandlineArgs>
                </configuration>
              </execution>
              <execution>
                <id>fetch-test262</id>
                <phase>generate-test-resources</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>git</executable>
                  <workingDirectory>${nashorn.test262.suite}</workingDirectory>
                  <commandlineArgs>-c protocol.version=2 fetch -q --depth 1 https://github.com/tc39/test262 ${nashorn.test262.commit}</commandlineArgs>
                </configuration>
              </execution>
              <execution>
                <id>checkout-test262</id>
                <phase>generate-test-resources</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>git</executable>
                  <workingDirectory>${nashorn.test262.suite}</workingDirectory>
                  <commandlineArgs>checkout -q ${nashorn.test262.commit}</commandlineArgs>
                </configuration>
              </execution>
              <execution>
                <id>fetch-octane</id>
                <phase>generate-test-resources</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>git</executable>
                  <successCodes><successCode>0</successCode><successCode>128</successCode></successCodes>
                  <commandlineArgs>clone --depth 1 https://github.com/chromium/octane ${nashorn.test.scripts}/external/octane</commandlineArgs>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <!--
        The ECMA-262 suite, ES2015 slice.
          mvn -Ptest262 verify
        Runs every test at the pinned commit whose "features:" are all ES2015 or
        absent - see Test262Selector - each one strict and sloppy unless its
        frontmatter says otherwise, and compares the result against
        test262-expectations.txt. The run fails on a new failure AND on a test
        that now passes but is still listed, so conformance only moves forwards.
        Rewrite the file after fixing something with:
          mvn -Ptest262 verify -Dnashorn.test262.write.expectations=true

        Always regenerate through Maven, never by invoking Test262Runner directly.
        The run inherits nashorn.test.jvmargs, which sets the Turkish locale on
        purpose; expectations recorded without it disagree with the gate on the
        ten locale-sensitive toLocale*Case tests.
      -->
      <id>test262</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>run-test262</id>
                <phase>verify</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>${java.home}/bin/java</executable>
                  <commandlineArgs>${nashorn.test.jvmargs} -Xmx4G -XX:-HeapDumpOnOutOfMemoryError -Dnashorn.typeInfo.disabled=true -Dtest262.suite.dir=${nashorn.test262.suite} -Dtest262.expectations=${nashorn.test262.expectations} -Dtest262.expectations.pessimistic=${nashorn.test262.expectations.pessimistic} -Dtest262.threads=${nashorn.test262.threads} -Dtest262.include=${nashorn.test262.include} -Dtest262.write.expectations=${nashorn.test262.write.expectations} -Dtest262.optimistic=${nashorn.test262.optimistic} -Dtest262.default.shards=${nashorn.test262.shards} -Dtest262.timeout.seconds=${nashorn.test262.timeout} -cp ${project.build.testOutputDirectory}${path.separator}${nashorn.test.libs}/* org.monflabs.nashorn.internal.test.framework.Test262Runner</commandlineArgs>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <!-- The normal script suite through ParallelTestRunner. Was test-parallel. -->
      <id>test-parallel</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>run-test-parallel</id>
                <phase>verify</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>${java.home}/bin/java</executable>
                  <commandlineArgs>${nashorn.test.jvmargs} -Dtest.root.dir=src/test "-Dtest.js.roots=${nashorn.test.scripts}/basic ${nashorn.test.scripts}/maptests ${nashorn.test.scripts}/error ${nashorn.test.scripts}/sandbox ${nashorn.test.scripts}/trusted ${nashorn.test.scripts}/nosecurity" -Dtest.js.framework=${nashorn.test.scripts}/assert.js "-Dtest.js.exclude.dir=${nashorn.test.scripts}/currently-failing ${nashorn.test.scripts}/external" -cp ${project.build.testOutputDirectory}${path.separator}${nashorn.test.libs}/* org.monflabs.nashorn.internal.test.framework.ParallelTestRunner</commandlineArgs>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <!--
        Octane. Replaces build-benchmark.xml, which spelled out a target per
        benchmark per runtime; the benchmark list is a property here instead.
        Disabled upstream and still disabled: code-load, typescript, zlib.

        run-octane.js finds the suite itself, relative to its own directory
        (octane-payload.js: path = __DIR__ + "../external/octane/"), so the
        only arguments are bare benchmark names.
          mvn -Pbenchmark verify [-Doctane.benchmarks="box2d crypto"]
      -->
      <id>benchmark</id>
      <properties>
        <octane.benchmarks>box2d crypto deltablue earley-boyer gbemu navier-stokes mandreel pdfjs raytrace regexp richards splay</octane.benchmarks>
        <octane.iterations>25</octane.iterations>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>run-octane</id>
                <phase>verify</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>${java.home}/bin/java</executable>
                  <!-- TypeProfileLevel=222 was run.test.jvmargs.octane.main:
                       better type profiling produces much better JIT code for JS -->
                  <commandlineArgs>${nashorn.test.jvmargs} -Xms2G -XX:TypeProfileLevel=222 -cp ${project.build.testOutputDirectory}${path.separator}${nashorn.test.libs}/* org.monflabs.nashorn.tools.Shell ${nashorn.test.scripts}/basic/run-octane.js -scripting -- ${octane.benchmarks} --runtime nashorn --verbose --iterations ${octane.iterations}</commandlineArgs>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <!-- SunSpider. Was the sunspider Ant target. -->
      <id>sunspider</id>
      <properties>
        <sunspider.iterations>3000</sunspider.iterations>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>run-sunspider</id>
                <phase>verify</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>${java.home}/bin/java</executable>
                  <commandlineArgs>${nashorn.test.jvmargs} -cp ${project.build.testOutputDirectory}${path.separator}${nashorn.test.libs}/* org.monflabs.nashorn.tools.Shell -timezone=PST --class-cache-size=50 ${nashorn.test.scripts}/basic/runsunspider.js -- ${nashorn.test.scripts}/external/sunspider/tests/sunspider-1.0.2/ --verbose --times ${sunspider.iterations}</commandlineArgs>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <!--
        Replaces the jcov setup in code_coverage.xml.

        Caveat: script tests carrying @fork run in child JVMs that this agent
        does not instrument, so their coverage is not counted. The agent is
        deliberately not added to test.fork.jvm.options - many forks appending
        to one exec file concurrently risks corrupting it.
          mvn -Pcoverage test
      -->
      <id>coverage</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <configuration>
              <excludes>
                <!-- classes Nashorn generates at runtime for compiled scripts;
                     was cc.exclude in project.properties -->
                <exclude>org/monflabs/nashorn/internal/scripts/**</exclude>
              </excludes>
            </configuration>
            <executions>
              <execution>
                <id>prepare-agent</id>
                <goals><goal>prepare-agent</goal></goals>
                <configuration>
                  <propertyName>nashorn.coverage.argLine</propertyName>
                </configuration>
              </execution>
              <execution>
                <id>report</id>
                <phase>verify</phase>
                <goals><goal>report</goal></goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <!-- Was the "run" Ant target: the engine on a sample script. -->
      <id>run</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>run-shell</id>
                <phase>verify</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>${java.home}/bin/java</executable>
                  <workingDirectory>${project.basedir}/../samples</workingDirectory>
                  <commandlineArgs>--module-path=${nashorn.test.modulepath} --add-modules=org.monflabs.nashorn -m org.monflabs.nashorn/org.monflabs.nashorn.tools.Shell -dump-on-error ${nashorn.run.script}</commandlineArgs>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
      <properties>
        <nashorn.run.script>test.js</nashorn.run.script>
      </properties>
    </profile>

    <profile>
      <!-- Was the "debug" Ant target: same, with code generation dumped. -->
      <id>debug</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>debug-shell</id>
                <phase>verify</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>${java.home}/bin/java</executable>
                  <workingDirectory>${project.basedir}/../samples</workingDirectory>
                  <commandlineArgs>--module-path=${nashorn.test.modulepath} --add-modules=org.monflabs.nashorn -Dnashorn.codegen.debug=true -m org.monflabs.nashorn/org.monflabs.nashorn.tools.Shell --print-code --verify-code --print-symbols ${nashorn.run.script}</commandlineArgs>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
      <properties>
        <nashorn.run.script>test.js</nashorn.run.script>
      </properties>
    </profile>
  </profiles>

</project>
