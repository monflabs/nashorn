<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.monflabs.nashorn</groupId>
    <artifactId>nashorn-parent</artifactId>
    <version>2019.0.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>nashorn-node</artifactId>
  <packaging>jar</packaging>
  <name>OpenJDK-Monflabs node modules</name>
  <description>
    EXPERIMENTAL, INCOMPLETE. A Node-compatibility module resolver, provided as
    a convenience and as a worked example of building built-in modules on the
    engine. Answers a handful of Node's built-in specifiers - fs, buffer, os,
    path - from bare or node: imports, in pure Java. It reaches into the
    engine's internal object model (core exports those packages to this module
    by name), so a given nashorn-node is a companion to the exact same version of
    nashorn-core; do not mix versions.
  </description>
  <dependencies>
    <dependency>
      <groupId>org.monflabs.nashorn</groupId>
      <artifactId>nashorn-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.testng</groupId>
      <artifactId>testng</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>${nashorn.target.java.version}</release>
          <compilerArgs>
            <arg>-Xlint:all</arg>
            <arg>-Xdiags:verbose</arg>
            <arg>-parameters</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- the tests build an engine and register the resolver explicitly, on the class path like an embedder -->
          <useModulePath>false</useModulePath>
          <argLine>-ea -esa</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <configuration>
          <tags>
            <tag><name>moduleGraph</name><placement>a</placement><head>Module Graph</head></tag>
          </tags>
          <quiet>true</quiet>
        </configuration>
      </plugin>
      <plugin>
        <!-- a published artifact: opt in to the Central Portal publisher declared in the parent -->
        <groupId>org.sonatype.central</groupId>
        <artifactId>central-publishing-maven-plugin</artifactId>
        <configuration>
          <skipPublishing>false</skipPublishing>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
