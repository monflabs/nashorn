<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.monflabs.nashorn</groupId>
    <artifactId>nashorn-parent</artifactId>
    <version>2017.0.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>nashorn-libs</artifactId>
  <packaging>jar</packaging>
  <name>OpenJDK-Monflabs standard libraries</name>
  <description>
    The standard libraries: script libraries that give every engine the
    host functions a script expects beyond the language - timers,
    queueMicrotask, atob/btoa - and the fetch API. Registered as services,
    so a jar on the path is enough. Published alongside nashorn-core.
  </description>
  <dependencies>
    <dependency>
      <groupId>org.monflabs.nashorn</groupId>
      <artifactId>nashorn-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.testng</groupId>
      <artifactId>testng</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>${nashorn.target.java.version}</release>
          <compilerArgs>
            <arg>-Xlint:all</arg>
            <arg>-Xdiags:verbose</arg>
            <arg>-parameters</arg>
          </compilerArgs>
        </configuration>
        <executions>
          <execution>
            <!-- the tests serve fetch from the JDK's own HTTP server, which the module itself does not need -->
            <id>default-testCompile</id>
            <configuration>
              <compilerArgs>
                <arg>-Xlint:all</arg>
                <arg>-parameters</arg>
                <arg>--add-modules</arg>
                <arg>jdk.httpserver</arg>
                <arg>--add-reads</arg>
                <arg>org.monflabs.nashorn.libs=jdk.httpserver</arg>
              </compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- on the class path like an embedder would: the libraries must be discovered from META-INF/services -->
          <useModulePath>false</useModulePath>
          <argLine>-ea -esa</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <configuration>
          <tags>
            <tag><name>moduleGraph</name><placement>a</placement><head>Module Graph</head></tag>
          </tags>
          <quiet>true</quiet>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
